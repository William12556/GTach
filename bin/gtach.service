[Unit]
Description=GTach OBD-II Tachometer
After=local-fs.target network-online.target bluetooth.service gtach-boot-splash.service hyperpixel2r-init.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gtach
ExecStartPre=-/opt/gtach/gtach-preflight.sh
ExecStart=/opt/gtach/venv/bin/gtach
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
