[Unit]
Description=GTach Boot Splash
DefaultDependencies=no
After=local-fs.target
Before=gtach.service

# Writes a static image directly to /dev/fb0 as raw pixel bytes, once.
#
# An earlier version used fbi, which requires ownership of a VT. fbi exits
# on its own moments after displaying a single image on a console with no
# keyboard input source to wait on (this Pi is touchscreen-only), and
# looping it to keep the image up caused visible flashing on every restart
# plus a race at handoff — fbi clears the screen before each redraw, and
# gtach.service's kill could land in that gap.
#
# A single dd write has none of that: no process holds the VT, nothing
# clears or redraws, nothing to race. The bytes just sit in framebuffer
# memory until GTach's first frame overwrites them.
#
# boot-splash.raw is generated by bin/gen_splash.py and must match the
# panel's exact framebuffer format (confirmed via `fbset -fb /dev/fb0`
# on gtach.local: 480x480, 32bpp, no stride padding, BGRA byte order).
# A format change on the device requires regenerating this file.
#
# tty1 stays in KD_TEXT mode by default, meaning the kernel's console
# layer (fbcon) still owns and can redraw onto the same physical
# framebuffer memory this writes into. A single stray character that
# slips past quiet/loglevel=0/systemd.show_status=0 earlier in boot
# gets stamped by fbcon at the cursor's default top-left position,
# overwriting a corner of the splash (confirmed on-device). The
# ExecStartPre switches tty1 to KD_GRAPHICS first, which stops fbcon
# compositing text onto the framebuffer entirely; it is never switched
# back, since nothing needs console text on tty1 for the rest of the
# session (getty@tty1 is masked) and GTach's own renderer does not
# touch VT mode either.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/python3 -c "import fcntl; f = open('/dev/tty1', 'rb'); fcntl.ioctl(f.fileno(), 0x4B3A, 1)"
ExecStart=/bin/dd if=/opt/gtach/boot-splash.raw of=/dev/fb0 bs=1M conv=notrunc

[Install]
WantedBy=multi-user.target
